    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@sentry/react": "^11.10.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.105.3",
    "axios": "^1.11.0",
    "motion": "^14.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.8.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.11",
    "zod": "^4.6.7"
