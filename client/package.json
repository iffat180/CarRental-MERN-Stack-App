{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e:stories": "npm run build-storybook && playwright test -c playwright.storybook.config.ts",
    "lighthouse": "VITE_BASE_URL= npm run build && lhci autorun --config=lighthouserc.json"
  },
