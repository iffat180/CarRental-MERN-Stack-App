{
  "dependencies": {
    "@pinecone-database/pinecone": "^6.1.3",
    "openai": "^6.9.1"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "scripts": {
    "format": "prettier --write \"client/{src,e2e}/**/*.{ts,tsx,css}\" \"client/*.{ts,js,json}\" \"server/**/*.ts\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"client/{src,e2e}/**/*.{ts,tsx,css}\" \"client/*.{ts,js,json}\" \"server/**/*.ts\" \".github/**/*.yml\""
  }
}
